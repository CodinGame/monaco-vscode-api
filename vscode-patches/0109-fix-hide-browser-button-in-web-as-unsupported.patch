From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lo=C3=AFc=20Mangeonjean?= <loic@coderpad.io>
Date: Thu, 15 Oct 2026 10:29:09 +0200
Subject: [PATCH] fix: hide browser button in web as unsupported

---
 .../contrib/editor/browser/addTabActions.ts        | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/src/vs/sessions/contrib/editor/browser/addTabActions.ts b/src/vs/sessions/contrib/editor/browser/addTabActions.ts
index 874c72489d6..e68f72dda9e 100644
--- a/src/vs/sessions/contrib/editor/browser/addTabActions.ts
+++ b/src/vs/sessions/contrib/editor/browser/addTabActions.ts
@@ -13,6 +13,7 @@ import { Action2, MenuRegistry } from '../../../../platform/actions/common/actio
 import { BrowserViewCommandId } from '../../../../platform/browserView/common/browserView.js';
 import { ICommandService } from '../../../../platform/commands/common/commands.js';
 import { ContextKeyExpr } from '../../../../platform/contextkey/common/contextkey.js';
+import { IsWebContext } from '../../../../platform/contextkey/common/contextkeys.js';
 import { IInstantiationService, ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';
 import { KeybindingWeight } from '../../../../platform/keybinding/common/keybindingsRegistry.js';
 import { BrowserEditorInput } from '../../../../workbench/contrib/browserView/common/browserEditorInput.js';
@@ -56,6 +57,11 @@ const filesTabActionWhen = ContextKeyExpr.and(
 	addTabActionWhen,
 	DesktopFilesTabAvailableContext);
 
+// The integrated browser is not available in web (`WebBrowserViewWorkbenchService`).
+const browserTabActionWhen = ContextKeyExpr.and(
+	addTabActionWhen,
+	IsWebContext.toNegated());
+
 const searchTabActionWhen = ContextKeyExpr.and(
 	addTabActionWhen,
 	IsQuickChatSessionContext.negate());
@@ -132,22 +138,22 @@ export class NewBrowserTabAction extends Action2 {
 			category: SessionsCategories.Sessions,
 			icon: Codicon.globe,
 			f1: true,
-			precondition: addTabActionWhen,
+			precondition: browserTabActionWhen,
 			keybinding: {
 				weight: KeybindingWeight.SessionsContrib,
-				when: addTabActionWhen,
+				when: browserTabActionWhen,
 				primary: KeyMod.CtrlCmd | KeyMod.Shift | KeyCode.KeyB,
 			},
 			menu: [{
 				id: Menus.SessionsEditorTabsBarAddTab,
 				group: 'navigation',
 				order: 2,
-				when: addTabLayoutWhen
+				when: ContextKeyExpr.and(addTabLayoutWhen, IsWebContext.toNegated())
 			}, {
 				id: Menus.SessionsEmptyEditorGroupAddTab,
 				group: 'navigation',
 				order: 2,
-				when: addTabLayoutWhen
+				when: ContextKeyExpr.and(addTabLayoutWhen, IsWebContext.toNegated())
 			}]
 		});
 	}
