From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lo=C3=AFc=20Mangeonjean?= <loic@coderpad.io>
Date: Mon, 11 Mar 2024 18:21:40 +0100
Subject: [PATCH] feat: add some parameter to webview iframes

---
 .../contrib/webview/browser/pre/index.html        |  8 +++++---
 .../contrib/webview/browser/webviewElement.ts     | 15 +++++++++++----
 2 files changed, 16 insertions(+), 7 deletions(-)

diff --git a/src/vs/workbench/contrib/webview/browser/pre/index.html b/src/vs/workbench/contrib/webview/browser/pre/index.html
index 42c7c01ade5..cb8972b33ed 100644
--- a/src/vs/workbench/contrib/webview/browser/pre/index.html
+++ b/src/vs/workbench/contrib/webview/browser/pre/index.html
@@ -5,7 +5,7 @@
 	<meta charset="UTF-8">
 
 	<meta http-equiv="Content-Security-Policy"
-		content="default-src 'none'; script-src 'sha256-FFQoOVVa2tOE3uqUvirwaMNT20TZmrHcL2aaOjJ8BUo=' 'self'; frame-src 'self'; style-src 'unsafe-inline';">
+		content="default-src 'none'; script-src 'sha256-9W7I0GuVb+VHattMgYRKTlyLE43yeuKNQzhYe9Nej+U=' 'self'; frame-src 'self'; style-src 'unsafe-inline';">
 
 	<!-- Disable pinch zooming -->
 	<meta name="viewport"
@@ -35,6 +35,8 @@
 		const onElectron = searchParams.get('platform') === 'electron';
 		const disableServiceWorker = searchParams.has('disableServiceWorker');
 		const expectedWorkerVersion = parseInt(searchParams.get('swVersion'));
+		const serviceWorkerUri = searchParams.get('serviceWorkerUri');
+		const fakeHtmlUri = searchParams.get('fakeHtmlUri');
 
 		/**
 		 * @param {string} name
@@ -252,7 +254,7 @@
 				return reject(new Error('Service Workers are not enabled. Webviews will not work. Try disabling private/incognito mode.'));
 			}
 
-			const swPath = encodeURI(`service-worker.js?v=${expectedWorkerVersion}&vscode-resource-base-authority=${searchParams.get('vscode-resource-base-authority')}&remoteAuthority=${searchParams.get('remoteAuthority') ?? ''}&platform=${searchParams.get('platform')}`);
+			const swPath = encodeURI(`${serviceWorkerUri}?v=${expectedWorkerVersion}&vscode-resource-base-authority=${searchParams.get('vscode-resource-base-authority')}&remoteAuthority=${searchParams.get('remoteAuthority') ?? ''}&platform=${searchParams.get('platform')}`);
 			navigator.serviceWorker.register(swPath, { type: 'module', updateViaCache: 'none' })
 				.then(async registration => {
 					if (navigator.serviceWorker.controller) {
@@ -1044,7 +1046,7 @@
 				if (globalThis.crossOriginIsolated) {
 					fakeUrlParams.set('vscode-coi', '3'); /*COOP+COEP*/
 				}
-				newFrame.src = `./fake.html?${fakeUrlParams.toString()}`;
+				newFrame.src = `${fakeHtmlUri}?${fakeUrlParams.toString()}`;
 
 				newFrame.style.cssText = 'display: block; margin: 0; overflow: hidden; position: absolute; width: 100%; height: 100%; visibility: hidden';
 				document.body.appendChild(newFrame);
diff --git a/src/vs/workbench/contrib/webview/browser/webviewElement.ts b/src/vs/workbench/contrib/webview/browser/webviewElement.ts
index 30e02d1253f..3210ac5c97b 100644
--- a/src/vs/workbench/contrib/webview/browser/webviewElement.ts
+++ b/src/vs/workbench/contrib/webview/browser/webviewElement.ts
@@ -15,7 +15,7 @@ import { Lazy } from '../../../../base/common/lazy.js';
 import { Disposable, IDisposable, toDisposable } from '../../../../base/common/lifecycle.js';
 import { observableValue } from '../../../../base/common/observable.js';
 import { listenStream } from '../../../../base/common/stream.js';
-import { COI, FileAccess } from '../../../../base/common/network.js';
+import { AppResourcePath, COI, FileAccess } from '../../../../base/common/network.js';
 import { URI } from '../../../../base/common/uri.js';
 import { generateUuid } from '../../../../base/common/uuid.js';
 import { localize } from '../../../../nls.js';
@@ -462,15 +462,22 @@ export class WebviewElement extends Disposable implements IWebviewElement, Webvi
 			params.purpose = options.purpose;
 		}
 
+		const asBrowserUri = (uri: AppResourcePath) => {
+			return FileAccess.asBrowserUri(uri)
+				.toString(true)
+				.replace('{{uuid}}', encodedWebviewOrigin);
+		};
+
+		params.serviceWorkerUri = asBrowserUri('vs/workbench/contrib/webview/browser/pre/service-worker.js');
+		params.fakeHtmlUri = asBrowserUri('vs/workbench/contrib/webview/browser/pre/fake.html');
+
 		COI.addSearchParam(params, true, true);
 
 		const queryString = new URLSearchParams(params).toString();
 
 		this.perfMark('init/set-src');
 
-		const relativeIframeSrc = FileAccess.asBrowserUri(`vs/workbench/contrib/webview/browser/pre/index.html`)
-			.toString(true)
-			.replace('{{uuid}}', encodedWebviewOrigin);
+		const relativeIframeSrc = asBrowserUri(`vs/workbench/contrib/webview/browser/pre/index.html`);
 		this.element!.setAttribute('src', `${relativeIframeSrc}?${queryString}`);
 	}
 
