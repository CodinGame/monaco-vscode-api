 .../contrib/dropOrPasteInto/browser/copyPasteController.ts  | 6 ++++--
 .../dropOrPasteInto/browser/dropIntoEditorController.ts     | 4 +++-
 .../contrib/dropOrPasteInto/browser/postEditWidget.ts       | 4 +++-
 src/vs/workbench/contrib/bulkEdit/browser/bulkTextEdits.ts  | 2 +-
 5 files changed, 12 insertions(+), 5 deletions(-)

