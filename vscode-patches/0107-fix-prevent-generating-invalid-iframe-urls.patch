  *--------------------------------------------------------------------------------------------*/
 
+import { URI } from '../common/uri.js';
+
 /**
  * Represents a window in a possible chain of iframes
  */
@@ -133,3 +135,23 @@ function sha256AsBase32(bytes: ArrayBuffer): string {
 	// sha256 has 256 bits, so we need at most ceil(lg(2^256-1)/lg(32)) = 52 chars to represent it in base 32
 	return BigInt(`0x${hexArray}`).toString(32).padStart(52, '0');
 }
+
+/**
+ * Replaces a URI authority placeholder without exceeding the DNS label length limit.
+ */
+export function replaceUriAuthorityPlaceholder(uri: URI, placeholder: string, replacement: string): URI {
+	const placeholderIndex = uri.authority.indexOf(placeholder);
+	if (placeholderIndex === -1) {
+		return uri;
+	}
+
+	const labelStart = uri.authority.lastIndexOf('.', placeholderIndex) + 1;
+	const labelEnd = uri.authority.indexOf('.', placeholderIndex + placeholder.length);
+	const labelLength = (labelEnd === -1 ? uri.authority.length : labelEnd) - labelStart;
+	const replacementLength = 63 - labelLength + placeholder.length;
+	if (replacementLength < 0) {
+		throw new Error('URI authority label exceeds the DNS length limit');
+	}
+
+	return uri.with({ authority: uri.authority.replace(placeholder, replacement.slice(0, replacementLength)) });
+}
