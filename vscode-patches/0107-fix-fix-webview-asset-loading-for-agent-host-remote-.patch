Subject: [PATCH] fix: fix webview asset loading for agent host remote assets

which root contains a query param
---
 src/vs/workbench/contrib/webview/browser/resourceLoading.ts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/vs/workbench/contrib/webview/browser/resourceLoading.ts b/src/vs/workbench/contrib/webview/browser/resourceLoading.ts
index a07024838d5..ff504d3c0df 100644
--- a/src/vs/workbench/contrib/webview/browser/resourceLoading.ts
+++ b/src/vs/workbench/contrib/webview/browser/resourceLoading.ts
@@ -134,6 +134,8 @@ export function getResourceToLoad(
 }
 
 function containsResource(root: URI, resource: URI, uriIdentityService: IUriIdentityService, forcePosixSemantics: boolean): boolean {
+	root = root.with({ query: null });
+	resource = resource.with({ query: null });
 	if (uriIdentityService.extUri.isEqual(root, resource, /* ignoreFragment */ true)) {
 		return false;
 	}
