From: =?UTF-8?q?Lo=C3=AFc=20Mangeonjean?= <loic@coderpad.io>
Date: Mon, 12 Oct 2026 17:07:08 +0200
Subject: [PATCH] feat: wait for authority when not yet registered

---
 .../common/agentHostFileSystemProvider.ts     | 36 +++++++++++++++----
 1 file changed, 29 insertions(+), 7 deletions(-)

diff --git a/src/vs/platform/agentHost/common/agentHostFileSystemProvider.ts b/src/vs/platform/agentHost/common/agentHostFileSystemProvider.ts
index d96446b3293..9f11344cccb 100644
--- a/src/vs/platform/agentHost/common/agentHostFileSystemProvider.ts
+++ b/src/vs/platform/agentHost/common/agentHostFileSystemProvider.ts
@@ -210,6 +210,7 @@ export abstract class AHPFileSystemProvider extends Disposable implements IFileS
 	 * Tests can override this via the constructor parameter.
 	 */
 	private static readonly _DEFAULT_CONNECTION_GRACE_MS = 5000;
+	private static readonly _DEFAULT_CONNECTION_REGISTRATION_MS = 30000;
 
 	constructor(
 		private readonly _connectionGraceMs: number = AHPFileSystemProvider._DEFAULT_CONNECTION_GRACE_MS,
@@ -564,18 +565,39 @@ export abstract class AHPFileSystemProvider extends Disposable implements IFileS
 
 	// ---- Internals ----------------------------------------------------------
 
-	private _getConnection(authority: string): Promise<IRemoteFilesystemConnection> {
+	private async _waitForAuthority(authority: string): Promise<IAuthorityEntry> {
 		const entry = this._authorities.get(authority);
-		if (!entry) {
-			return Promise.reject(createFileSystemProviderError(
-				`No connection for authority: ${authority}`,
-				FileSystemProviderErrorCode.Unavailable,
-			));
+		if (entry) {
+			return entry;
+		}
+		const store = new DisposableStore();
+		try {
+			return await new Promise<IAuthorityEntry>((resolve, reject) => {
+				const unavailable = (): void => reject(createFileSystemProviderError(
+					`No connection for authority: ${authority}`,
+					FileSystemProviderErrorCode.Unavailable,
+				));
+				store.add(this._onDidChangeConnection.event(changedAuthority => {
+					if (changedAuthority === authority) {
+						const registered = this._authorities.get(authority);
+						if (registered) {
+							resolve(registered);
+						}
+					}
+				}));
+				store.add(disposableTimeout(unavailable, AHPFileSystemProvider._DEFAULT_CONNECTION_REGISTRATION_MS));
+			});
+		} finally {
+			store.dispose();
 		}
+	}
+
+	private async _getConnection(authority: string): Promise<IRemoteFilesystemConnection> {
+		const entry = await this._waitForAuthority(authority);
 
 		const active = entry.connections.at(-1);
 		if (active) {
-			return Promise.resolve(active);
+			return active;
 		}
 		// Entry is inside its grace window after the last registration
 		// was disposed. Wait until either a new registration arrives
