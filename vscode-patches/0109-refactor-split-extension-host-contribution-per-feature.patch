+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { extHostNamedCustomer } from '../../services/extensions/common/extHostCustomers.js';
+import { MainContext } from '../common/extHost.protocol.js';
+
+// No-op main-thread customers for the optional feature bridges (chat / language-model / AI / speech,
+// notebook, mcp) that are split out of extensionHost.base.contribution. VS Code's extension host
+// asserts that every MainContext proxy is registered (mainThreadExtensionService ->
+// ExtensionHostManager.assertRegistered), so when a feature's service override is not installed its
+// real bridge is absent and the ext host would throw "Missing proxy instance" at startup. These
+// stubs satisfy that assertion. When an override IS installed its real bridge registers *after* this
+// module (each feature contribution imports this first) and wins the rpcProtocol.set() — the customer
+// registry is push-ordered and the last set() for an id wins — so the stub is inert. The stub's
+// methods are never called: the ext host only invokes a MainThread* actor when an extension uses the
+// corresponding (now-disabled) API.
+class NoopMainThreadCustomer {}
+
+for (const id of [
+    MainContext.MainThreadLanguageModels,
+    MainContext.MainThreadChatAgents2,
+    MainContext.MainThreadCodeMapper,
+    MainContext.MainThreadLanguageModelTools,
+    MainContext.MainThreadEmbeddings,
+    MainContext.MainThreadSpeech,
+    MainContext.MainThreadAiRelatedInformation,
+    MainContext.MainThreadAiEmbeddingVector,
+    MainContext.MainThreadAiSettingsSearch,
+    MainContext.MainThreadChatContext,
+    MainContext.MainThreadChatDebug,
+    MainContext.MainThreadChatStatus,
+    MainContext.MainThreadChatQuota,
+    MainContext.MainThreadChatInputNotification,
+    MainContext.MainThreadChatSessions,
+    MainContext.MainThreadNotebook,
+    MainContext.MainThreadNotebookKernels,
+    MainContext.MainThreadNotebookDocuments,
+    MainContext.MainThreadNotebookEditors,
+    MainContext.MainThreadNotebookRenderers,
+    MainContext.MainThreadMcp
+]) {
+    extHostNamedCustomer(id)(NoopMainThreadCustomer);
+}
